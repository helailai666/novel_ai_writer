# ─── NovelAI Writer 环境变量配置 ────────────────────────────────
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# ─── LLM 配置（至少配一个，不配则用 Mock 降级） ─────────────────
# 供应商: openai / deepseek / ollama / azure / anthropic / gemini / qwen / glm / kimi / mock
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com

# 各供应商独立 Key（可选，优先于 LLM_API_KEY）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=        # 通义千问
ZHIPU_API_KEY=            # 智谱 GLM
MOONSHOT_API_KEY=         # Kimi
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# ─── 搜索配置（可选，不配则用 DuckDuckGo；auto 模式自动降级） ───
# 模式: auto / tavily / duckduckgo / bing / searxng / bocha / mock
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BING_API_KEY=
BOCHA_API_KEY=
SEARXNG_URL=

# ─── 向量化配置（可选，不配则用 mock 哈希向量） ─────────────────
EMBEDDING_PROVIDER=mock      # openai / local / mock
EMBEDDING_MODEL=text-embedding-3-small

# ─── 向量存储（可选） ────────────────────────────────────────────
VECTOR_STORE_BACKEND=chroma   # chroma / faiss / mock
VECTOR_STORE_PERSIST_DIR=./data/vectorstore

# ─── Agent 编排 ──────────────────────────────────────────────────
AGENT_MAX_REVISIONS=2          # 章节写作图最大修订轮数
AGENT_REVIEW_THRESHOLD=75      # 低于该分触发 rewrite

# ─── MCP（可选） ─────────────────────────────────────────────────
MCP_ENABLED=true
MCP_SERVERS_FILE=config/mcp_servers.yaml

# ─── Skills（可选） ──────────────────────────────────────────────
SKILLS_DIRS=skills

# ─── 服务配置 ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false
