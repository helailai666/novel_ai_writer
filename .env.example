# ─── NovelAI Writer 环境变量配置 ────────────────────────────────
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# ─── LLM 配置（至少配一个，不配则用 Mock 降级） ─────────────────
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 提供商选择: openai / deepseek / ollama
# LLM_PROVIDER=deepseek

# ─── 搜索配置（可选，不配则用 DuckDuckGo） ──────────────────────
TAVILY_API_KEY=

# ─── 服务配置 ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
